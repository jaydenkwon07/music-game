[ext_resource type="PackedScene" path="res://scenes/world.tscn" id="1_world"]

; Render pipeline (M4 §6, D-M4-4): a FIXED 640×360 SubViewport (the pixel-art
; internal resolution) shown through a TextureRect that scales it to fill the
; window at any size, letterboxed. Nearest filtering keeps pixels crisp. Post-
; process shaders attach to the Display later, running at output resolution after
; the upscale. Manual input forwarding lives in main.gd (a bare SubViewport gets
; no input on its own).

[node name="Main" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="GameViewport" type="SubViewport" parent="."]
size = Vector2i(640, 360)
render_target_update_mode = 4
snap_2d_transforms_to_pixel = true
snap_2d_vertices_to_pixel = true

[node name="World" parent="GameViewport" instance=ExtResource("1_world")]

[node name="Display" type="TextureRect" parent="."]
texture_filter = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
