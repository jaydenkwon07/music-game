[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/world.tscn" id="1_world"]

; Render pipeline (M4 §6, D-M4-4; two-stage scale added M5 Step 0, CLAUDE.md §1).
; The world renders into a FIXED 960×540 SubViewport (the pixel-art internal
; resolution — 32×18 grid, 30px tiles). Scaling to the window is two stages:
;   GameViewport (960×540, nearest) -> Prescale SubViewport (nearest upscale to the
;   largest INTEGER multiple that fits) -> Display TextureRect (bilinear resample
;   of that already-correct image to the window, letterboxed to keep aspect).
; The integer step fixes pixel shape; the bilinear step keeps 1440p (a ×2.67
; target) from shimmering or letterboxing 44% of the screen. 1080p/4K are exact.
; Prescale is resized per window in main.gd. Post-process shaders attach to the
; Display later (output resolution, after the upscale). Manual input forwarding
; lives in main.gd (a bare SubViewport gets no input on its own).

[node name="Main" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="GameViewport" type="SubViewport" parent="."]
size = Vector2i(960, 540)
render_target_update_mode = 4
snap_2d_transforms_to_pixel = true
snap_2d_vertices_to_pixel = true

[node name="World" parent="GameViewport" instance=ExtResource("1_world")]

[node name="Prescale" type="SubViewport" parent="."]
size = Vector2i(1920, 1080)
render_target_update_mode = 4
transparent_bg = true

[node name="PrescaleRect" type="TextureRect" parent="Prescale"]
texture_filter = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 0

[node name="Display" type="TextureRect" parent="."]
texture_filter = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5
